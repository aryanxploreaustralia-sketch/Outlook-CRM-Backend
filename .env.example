# ---------------------------------------------------------------------------
# Xplore Australia CRM — backend environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored. This template is committed so every developer knows
# exactly which variables the service requires. Every value here is validated
# against a schema at startup (src/config/env.js); the process refuses to boot
# if anything is missing or malformed.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# Port the HTTP server binds to.
PORT=5000

# Interface to bind. Use 0.0.0.0 inside containers.
HOST=localhost

# Prefix applied to every API route, e.g. /api/v1/health
API_PREFIX=/api

# --- Database --------------------------------------------------------------
# Standard MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/outlook_automation_crm
# Atlas:          mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/outlook_automation_crm

# Milliseconds Mongoose waits to select a server before failing a connection.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Maximum pooled connections held open to MongoDB.
MONGODB_MAX_POOL_SIZE=10

# --- CORS ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
#
# An ORIGIN is scheme + host + port and nothing else — this is the FRONTEND's
# address, not this API's. Paths and trailing slashes are stripped when the list
# is parsed, so `https://crm.example.com/` works, but write it without.
#
# Production, with the app and the API on separate subdomains:
#     CORS_ORIGINS=https://crm.xploreaustralia.com
#
# Getting this wrong produces a failure that looks nothing like its cause: the
# browser blocks the response and reports a generic network error, so the API
# appears to be down while its logs show the request being served normally.
# Must include the Vite dev server during development.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Logging ---------------------------------------------------------------
# One of: error | warn | info | http | debug
LOG_LEVEL=debug

# Directory for rotated log files, relative to the backend root.
LOG_DIR=logs

# Days to retain rotated log files before deletion.
LOG_MAX_FILES=14d

# --- Rate limiting ---------------------------------------------------------
# Sliding window length in milliseconds (900000 = 15 minutes).
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests allowed per IP within one window.
RATE_LIMIT_MAX=300

# --- Request handling ------------------------------------------------------
# Maximum accepted JSON/urlencoded request body size.
BODY_LIMIT=1mb

# --- Web client ------------------------------------------------------------
# Origin of the React app. The OAuth callback redirects the browser here once
# sign-in completes.
#
# Production: FRONTEND_URL=https://crm.xploreaustralia.com
#
# Distinct from CORS_ORIGINS above even though they name the same host: that one
# decides who may CALL this API, this one decides where a completed sign-in is
# SENT. A deployment serving two frontends would list both there and pick one
# here.
FRONTEND_URL=http://localhost:5173

# Path within the web client the callback returns to after a SUCCESSFUL sign-in.
POST_LOGIN_REDIRECT_PATH=/dashboard

# Public sign-in page. Sign-in FAILURES redirect here rather than to the path
# above, because that one sits behind a route guard — an unauthenticated browser
# would be bounced again and the error message lost.
CLIENT_LOGIN_PATH=/login

# ---------------------------------------------------------------------------
# MICROSOFT IDENTITY PLATFORM (Phase 2)
#
# Obtain these from the Azure Portal. Full walkthrough: docs/AZURE_SETUP.md
#
# All four may be left blank to run the API without authentication — the auth
# routes then return 503 with setup guidance rather than the process refusing to
# boot. Setting some but not all is rejected at startup, because a partial
# configuration only fails once a user clicks "sign in".
#
# In production (NODE_ENV=production) all of them are mandatory.
# ---------------------------------------------------------------------------

# Entra ID → App registrations → your app → Overview → "Application (client) ID"
MICROSOFT_CLIENT_ID=

# Entra ID → your app → Certificates & secrets → New client secret → copy VALUE
# (not the Secret ID). It is shown only once; treat it like a password.
MICROSOFT_CLIENT_SECRET=

# Entra ID → your app → Overview → "Directory (tenant) ID".
# Or a well-known value:
#   common         → any Microsoft account, work/school or personal
#   organizations  → work/school accounts in any tenant
#   consumers      → personal Microsoft accounts only
MICROSOFT_TENANT_ID=

# Must match a Redirect URI registered on the app registration EXACTLY,
# including scheme, host, port and path. Entra ID allows plain HTTP only for
# localhost; any other host must use HTTPS.
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/v1/auth/callback

# Sovereign clouds use a different authority host, e.g.
# https://login.microsoftonline.us — leave the default for the public cloud.
MICROSOFT_AUTHORITY_HOST=https://login.microsoftonline.com
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
MICROSOFT_GRAPH_API_VERSION=v1.0

# Delegated permissions requested at sign-in.
#   openid          identifies the signed-in user
#   offline_access  causes Entra ID to issue a refresh token — without it,
#                   access expires in about an hour and cannot be renewed
#   User.Read       read the signed-in user's profile
#   Mail.Send       send mail as the user
#   Mail.Read       read the user's mail
#   Mail.ReadWrite  create, update and delete the user's mail
# Calendar and Contacts permissions are deliberately NOT requested.
MICROSOFT_GRAPH_SCOPES=openid,offline_access,User.Read,Mail.Send,Mail.Read,Mail.ReadWrite

# ---------------------------------------------------------------------------
# GOOGLE SIGN-IN (Phase 13.1)
#
# Identity ONLY. Google authenticates the people who use the CRM. It never
# sends, reads or syncs mail — that stays entirely with the Microsoft provider
# above, and the two are configured, enabled and failed independently.
#
# Full walkthrough: docs/GOOGLE_SETUP.md
#
# All three may be left blank. The API then boots normally and the Google
# sign-in routes return 503 with setup guidance, exactly as the Microsoft
# routes do when Azure is unconfigured. Setting some but not all is rejected at
# startup, because a partial configuration only fails once a user clicks the
# button.
#
# Unlike the Microsoft group, these are NOT mandatory when NODE_ENV=production.
# ---------------------------------------------------------------------------

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# -> your Web application client -> "Client ID". Ends in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# The same screen -> "Client secret". Treat it like a password.
GOOGLE_CLIENT_SECRET=

# Must match an "Authorised redirect URI" on that client EXACTLY, including
# scheme, host, port and path. Google permits plain HTTP only for localhost.
#   development: http://localhost:5000/api/v1/auth/google/callback
#   production:  https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=

# Optional Workspace restriction, comma-separated. Empty means any Google
# account with a Google-verified email address may sign in. Set this to your
# company domain to limit the CRM to your own Workspace.
#   e.g. GOOGLE_ALLOWED_DOMAINS=yourcompany.com
GOOGLE_ALLOWED_DOMAINS=

# Scopes requested at sign-in. Identity only — deliberately minimal, and
# deliberately containing no Gmail scope of any kind.
#   openid   identifies the signed-in user
#   email    the address, plus whether Google has verified it
#   profile  display name and avatar
GOOGLE_SCOPES=openid,email,profile

# ---------------------------------------------------------------------------
# MAIL ENGINE
# ---------------------------------------------------------------------------

# Body ceiling for /api/v1/mail/* only. Attachments travel as base64, which
# inflates them by ~33%, so the global BODY_LIMIT above is far too small. Kept
# separate so every other endpoint still rejects an oversized body cheaply.
MAIL_BODY_LIMIT=8mb

# Combined across To + Cc + Bcc on a single message.
MAIL_MAX_RECIPIENTS=100

MAIL_MAX_ATTACHMENTS=10

# Combined DECODED size of all attachments on one message, in bytes.
# Microsoft Graph rejects any /me/sendMail request over 4 MB, and that budget
# includes the body and headers. 3 MB leaves headroom. Files larger than this
# need a Graph upload session against a draft, which is not implemented yet.
MAIL_MAX_ATTACHMENT_BYTES=3145728

# ---------------------------------------------------------------------------
# SESSIONS AND TOKEN STORAGE
#
# Generate both with:  npm run generate:secrets
# Use different values in every environment, and never commit them.
# ---------------------------------------------------------------------------

# Signs session cookies. Minimum 32 characters.
SESSION_SECRET=

# Base64-encoded 32-byte key used to encrypt stored Microsoft token caches with
# AES-256-GCM.
#
# WARNING: rotating this makes every stored token cache permanently unreadable,
# forcing all users to reconnect their Microsoft account.
TOKEN_ENCRYPTION_KEY=

# Name of the session cookie.
SESSION_COOKIE_NAME=oac.sid

# Session lifetime in hours (168 = 7 days).
SESSION_TTL_HOURS=168

# How long an unfinished OAuth sign-in remains valid, in minutes.
AUTH_FLOW_TTL_MINUTES=10

# ---------------------------------------------------------------------------
# MORNING SCHEDULER (Phase H3)
# ---------------------------------------------------------------------------

# Where the daily export is dropped for the scheduler to find.
#
# Every morning at the configured time the scheduler takes the NEWEST .xlsx in
# this folder, checks it has not been processed before, and hands it to the
# existing background workbook queue. It never parses, compares or emails
# anything itself.
#
# Relative paths resolve against the backend package root. Files are left in
# place after processing: the scheduler remembers a workbook by the SHA-256 of
# its contents, so the same file is never imported twice however many times the
# server restarts.
#
# Excel lock files (~$name.xlsx), dotfiles, empty files and files modified in
# the last 15 seconds (still being copied) are ignored.
#
# Everything else about the schedule - whether it runs, at what time, in which
# timezone, and how it retries - is configured per workspace on the Settings
# screen and stored in the database, so it can be changed without a redeploy.
WORKBOOK_INBOX_DIR=storage/workbooks/inbox

# ---------------------------------------------------------------------------
# RESERVED FOR LATER PHASES — not read by the current code.
#
# BullMQ + Redis settings (Phase 4) will be added here when implemented. They
# are intentionally omitted rather than stubbed, so the schema never validates
# against variables nothing consumes.
# ---------------------------------------------------------------------------

# --- Audit -------------------------------------------------------------------
# How long audit entries are kept, in days. Enforced by a MongoDB TTL index.
# 0 keeps them forever, for a deployment under legal hold.
AUDIT_RETENTION_DAYS=365
