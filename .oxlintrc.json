{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "es2024": true
  },
  "plugins": ["oxc", "import"],
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_|^next$" }],
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "ignorePatterns": ["logs/**", "node_modules/**"]
}
